# Backend environment variables
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://snacki:snacki@localhost:5432/snacki?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-secret"
JWT_EXPIRES_IN="3600"
# Firma de los QR de compra (obligatoria en producción, distinta de JWT_SECRET)
QR_SECRET="change-me-qr-secret-use-another-long-random-value"
# La APK de Android usa el origen https://localhost (ya permitido por defecto)
CORS_ORIGIN="http://localhost:8100,http://localhost:4200,capacitor://localhost,ionic://localhost,https://localhost"
PLATFORM_TENANT_NAME="Snacki"
PLATFORM_TENANT_SLUG="snacki"
# Crea usuarios demo (cliente@snacki.demo / comercio@snacki.demo, clave Demo1234!) y saldo de ejemplo
SEED_DEMO_USERS="true"
